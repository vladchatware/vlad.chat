# Notion MCP OAuth (optional)
# NOTION_OAUTH_JWT_SECRET= # Auto-derived from CONVEX_DEPLOYMENT if not set

# Computer use (V-83) — mounted on site MCP (/api/mcp) for lounge + any MCP client.
# Off by default. Requires Vercel Sandbox auth on the Next.js/Vercel host.
# COMPUTER_USE_ENABLED=1
# Prefer OIDC on Vercel deployments; for local/CI use access-token triplet:
# VERCEL_OIDC_TOKEN=
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# Optional: reuse a snapshot with Playwright preinstalled
# COMPUTER_USE_SNAPSHOT_ID=
# Convex needs NEXT_PUBLIC_SITE_URL pointing at the host that serves /api/mcp.
